    "git",
    "gptfdisk",
    "grub",
    "intel-ucode",
    "konsole",
    "kscreen",
    "linux-firmware",
    "linux-lts",
    "mesa",
    "mkinitcpio",
    "networkmanager",
    "noto-fonts",
    "openssh",
    "pacman-contrib",
    "pciutils",
    "pipewire",
    "pipewire-pulse",
    "plasma-desktop",
    "plasma-nm",
    "plasma-pa",
    "plasma-workspace",
    "qemu-guest-agent",
    "rsync",
    "sddm",
    "spice-vdagent",
    "sudo",
    "systemd-ukify",
    "tmux",
    "tree",
    "ttf-dejavu",
    "vim",
    "wireplumber",
    "xdg-desktop-portal-kde"
