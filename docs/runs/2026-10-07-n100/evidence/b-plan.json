  "file_changes": {
    "add": [],
    "change": [
      "/etc/looom-hardware-generation"
    ],
    "remove": []
  },
  "health": {
    "required_units": [
      "sshd.service",
      "NetworkManager.service"
    ]
  },
  "kernel": {
    "extra_command_line": [],
    "package": "linux-lts"
  },
  "packages": {
    "add": {
      "linux-lts": "6.18.54-2",
      "tree": "2.3.2-1"
    },
    "remove": {
      "linux": "7.2.8.arch1-2"
    },
    "upgrade": {}
  },
  "persistent": {
    "directories": {
      "/etc/NetworkManager/system-connections": {
        "group": "root",
        "id": "network-connections",
        "mode": "0700",
        "owner": "root"
      },
      "/etc/looom-local": {
        "group": "root",
        "id": "local-settings",
        "mode": "0700",
        "owner": "root"
      }
    }
  },
  "system": {
    "console_keymap": "us",
    "hostname": "looom-pc",
    "locale": "en_US.UTF-8",
    "timezone": "Europe/Moscow"
  },
  "target_packages": 653,
  "unit_changes": {
    "bluetooth.service": {
      "new": "masked",
      "old": null
    }
  }
}
